# Copy this file to .env and fill in your own values. .env is gitignored.

# Your FPL team's entry ID, found in the URL when logged in:
# https://fantasy.premierleague.com/entry/YOUR_ENTRY_ID/event/1
FPL_ENTRY_ID=

# Understat season to scrape, e.g. 2026 for the 2026/27 season
UNDERSTAT_SEASON=2026

# Optional override for where the SQLite file lives.
# Defaults to <repo_root>/data/fpl.db if unset.
FPL_DB_PATH=
